@model NoteX.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NoteX | Login</title>
    <link rel="stylesheet" href="~/css/Login/login.css" />
</head>
<body>
    <section class="login-shell">
        <h1>Welcome back</h1>
        <p class="subtitle">Sign in to your NoteX workspace</p>

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" placeholder="admin@notex.local" />
                <span asp-validation-for="Email" class="validation-summary"></span>
            </div>

            <div class="field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" placeholder="Password123!" />
                <span asp-validation-for="Password" class="validation-summary"></span>
            </div>

            <div class="remember">
                <input asp-for="RememberMe" type="checkbox" />
                <label asp-for="RememberMe">Remember me</label>
            </div>

            <button type="submit">Login</button>
        </form>

        <a class="footer-link" href="/">Return to landing page</a>
    </section>
</body>
</html>

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NoteX — Liquid Glass Study Suite</title>

  <!-- PWA Manifest & App Metas -->
  <meta name="theme-color" content="#0D82FF" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <link rel="manifest" id="manifest-link" />

  <!-- Prevent browser from forcing dark background/text inversion -->
  <meta name="color-scheme" content="light dark" />

  <!-- Tailwind configuration -->
  <script>
    window.tailwind = {
      darkMode: 'selector'
    }
  </script>
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- External Libraries -->
  <script src="https://unpkg.com/lucide@0.400.0/dist/umd/lucide.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@@supabase/supabase-js@2"></script>

  <link rel="stylesheet" href="~/css/MainPage/mainpage.css" />
</head>

<body class="h-screen overflow-hidden relative">

  <canvas id="webgl-pearl-canvas"></canvas>

  <!-- MOBILE SIDEBAR BACKDROP OVERLAY -->
  <div id="mobile-sidebar-overlay" onclick="toggleMobileSidebar(false)" class="fixed inset-0 z-40 bg-black/60 hidden md:hidden transition-opacity"></div>

  <div class="relative flex h-full w-full p-2 md:p-5 gap-3 md:gap-6">

    <!-- APP SHELL -->
    <aside id="app-sidebar" class="fixed md:static inset-y-0 left-0 z-50 -translate-x-full md:translate-x-0 w-[270px] h-full onyx-panel rounded-r-3xl md:rounded-3xl flex flex-col p-4 shrink-0 transition-all duration-300 shadow-2xl md:shadow-xl">
      <div class="flex items-center justify-between pb-3 border-b border-[#B8DAFF]/40 dark:border-white/10">
        <div class="flex items-center gap-2.5 overflow-hidden">
          <img 
  src="/Assets/logo.png" 
  alt="NoteX Logo" 
  class="w-9 h-9 shrink-0 rounded-2xl object-cover shadow-lg shadow-blue-500/20 border border-white/15" 
/>
          <div class="sidebar-text truncate">
            <h1 class="font-black text-sm tracking-wide text-neutral-900 dark:text-white">NoteX</h1>
            <p class="text-[10px] text-neutral-500 dark:text-neutral-400 font-semibold tracking-wider uppercase">Flashcards & Exams</p>
          </div>
        </div>

        <div class="flex items-center">
          <button onclick="toggleMobileSidebar(false)" class="md:hidden p-2 rounded-xl text-neutral-600 dark:text-neutral-300">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
          <button onclick="toggleSidebarRail()" id="sidebar-rail-btn" class="hidden md:flex p-2 rounded-xl hover:bg-white/60 dark:hover:bg-white/10 text-neutral-700 dark:text-neutral-300 transition" title="Toggle Navigation Rail">
            <i data-lucide="panel-left-close" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <!-- ACADEMIC PERIOD FILTER -->
      <div class="py-3 border-b border-[#B8DAFF]/30 dark:border-white/10 sidebar-text">
        <span class="text-[10px] font-bold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider block mb-2 px-1">Academic Period</span>
        <div class="grid grid-cols-3 gap-1.5" id="period-button-group">
          <button onclick="setPeriodFilter('All')" class="period-pill py-1.5 px-2 rounded-xl text-xs font-bold transition bg-[#0D82FF] text-white shadow-sm text-center" data-period="All">All</button>
          <button onclick="setPeriodFilter('Prelim')" class="period-pill py-1.5 px-2 rounded-xl text-xs font-semibold hover:bg-white/70 dark:hover:bg-white/10 text-neutral-600 dark:text-neutral-300 transition text-center" data-period="Prelim">Prelim</button>
          <button onclick="setPeriodFilter('Midterm')" class="period-pill py-1.5 px-2 rounded-xl text-xs font-semibold hover:bg-white/70 dark:hover:bg-white/10 text-neutral-600 dark:text-neutral-300 transition text-center" data-period="Midterm">Midterm</button>
          <button onclick="setPeriodFilter('Semi-Final')" class="period-pill py-1.5 px-2 rounded-xl text-xs font-semibold hover:bg-white/70 dark:hover:bg-white/10 text-neutral-600 dark:text-neutral-300 transition text-center" data-period="Semi-Final">Semi</button>
          <button onclick="setPeriodFilter('Finals')" class="period-pill py-1.5 px-2 rounded-xl text-xs font-semibold hover:bg-white/70 dark:hover:bg-white/10 text-neutral-600 dark:text-neutral-300 transition text-center" data-period="Finals">Finals</button>
        </div>
      </div>

      <!-- SUBJECT FOLDERS -->
      <div class="flex-1 overflow-y-auto py-3 space-y-1.5" id="subject-nav-list"></div>

      <div class="pt-3 border-t border-[#B8DAFF]/30 dark:border-white/10 space-y-2">
        <button onclick="openNewSubjectModal()" class="w-full btn-action-pill flex items-center justify-center gap-2 py-2.5 rounded-2xl text-xs font-bold bg-white/70 dark:bg-white/10 text-neutral-800 dark:text-neutral-200 border border-[#B8DAFF]/50 dark:border-white/10 shadow-sm">
          <i data-lucide="folder-plus" class="w-4 h-4"></i>
          <span class="sidebar-text">New Subject</span>
        </button>

        <div class="flex gap-2 items-center">
          <button onclick="exportJSONBackup()" title="Backup Decks to JSON" class="flex-1 py-2 rounded-xl bg-white/70 dark:bg-white/10 hover:bg-white dark:hover:bg-white/20 border border-[#B8DAFF]/50 dark:border-white/10 flex justify-center text-xs text-neutral-700 dark:text-neutral-300 transition">
            <i data-lucide="download" class="w-4 h-4"></i>
          </button>
          <label title="Restore from JSON Backup" class="flex-1 py-2 rounded-xl bg-white/70 dark:bg-white/10 hover:bg-white dark:hover:bg-white/20 border border-[#B8DAFF]/50 dark:border-white/10 flex justify-center text-xs text-neutral-700 dark:text-neutral-300 transition cursor-pointer">
            <i data-lucide="upload" class="w-4 h-4"></i>
            <input type="file" id="json-restore-input" accept=".json" class="hidden" onchange="importJSONBackup(event)">
          </label>
          <div class="theme-switch shrink-0" onclick="toggleTheme()" title="Switch Light/Dark Mode">
            <div class="sun-moon"></div>
            <div class="clouds-stars">
              <div class="cloud"></div>
              <div class="star"></div>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <!-- CONTENT VIEWPORT -->
    <main class="flex-1 h-full flex flex-col gap-3 md:gap-4 overflow-hidden">
      <header class="onyx-panel rounded-3xl p-3.5 md:p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shrink-0 shadow-lg">
        <div class="flex items-center gap-2.5 flex-1 min-w-0">
          <button onclick="toggleMobileSidebar(true)" class="md:hidden p-2 rounded-xl bg-white/70 dark:bg-white/10 border border-[#B8DAFF]/50 shrink-0">
            <i data-lucide="menu" class="w-4 h-4"></i>
          </button>
          <div class="flex items-center gap-2 text-xs font-semibold text-neutral-500 dark:text-neutral-400 truncate">
            <span id="breadcrumb-subject" class="font-black text-neutral-800 dark:text-white text-sm truncate">All Subjects</span>
            <span>/</span>
            <span id="breadcrumb-period" class="px-2.5 py-0.5 rounded-full text-[11px] bg-[#E1EFFF] text-[#0D82FF] dark:bg-[#1B2B44] dark:text-[#389BFF] font-bold border border-blue-200/60 dark:border-blue-700/50 shrink-0">All</span>
          </div>

          <!-- UNIVERSAL SEARCH BAR -->
          <div class="relative ml-2 sm:ml-4 flex-1 max-w-xs">
            <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400"></i>
            <input id="global-search-input" oninput="handleSearch(this.value)" type="text" placeholder="Search decks, prompts, terms..." class="w-full pl-8 pr-7 py-1.5 rounded-xl bg-white/70 dark:bg-neutral-800/80 border border-[#B8DAFF]/50 dark:border-white/10 text-xs text-neutral-800 dark:text-neutral-100 placeholder-neutral-400 outline-none focus:border-[#0D82FF]" />
            <button id="search-clear-btn" onclick="clearSearch()" class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200">
              <i data-lucide="x" class="w-3 h-3"></i>
            </button>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-1.5 md:gap-2">
          <button onclick="openSmartImporterModal()" class="btn-skew px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 bg-white/80 dark:bg-white/10 text-neutral-800 dark:text-white">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-500"></i>
            <span class="hidden sm:inline">Quick Notes</span>
          </button>
          <button onclick="triggerQuickAction('flashcards')" class="btn-action-pill px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 bg-white/80 dark:bg-white/10 text-neutral-800 dark:text-white border border-[#B8DAFF]/50 dark:border-white/10">
            <i data-lucide="layers" class="w-3.5 h-3.5 text-[#0D82FF]"></i>
            <span class="hidden sm:inline">Cards</span>
          </button>
          <button onclick="triggerQuickAction('exam')" class="btn-action-pill px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 bg-white/80 dark:bg-white/10 text-neutral-800 dark:text-white border border-[#B8DAFF]/50 dark:border-white/10">
            <i data-lucide="clipboard-check" class="w-3.5 h-3.5 text-emerald-500"></i>
            <span class="hidden sm:inline">Exam</span>
          </button>
          <button onclick="openNewDeckModal()" class="btn-action-pill px-3.5 py-1.5 rounded-xl text-xs font-black flex items-center gap-1.5 bg-[#0D82FF] text-white shadow-md shadow-blue-500/20">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            <span>New Deck</span>
          </button>
        </div>
      </header>

      <div id="viewport-content" class="flex-1 overflow-y-auto space-y-5 pr-1 pb-8"></div>
    </main>
  </div>

  <!-- EDIT SUBJECT MODAL -->
  <div id="modal-edit-subject" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md hidden">
    <div class="modal-panel onyx-panel w-full max-w-sm rounded-3xl p-6 space-y-4 shadow-2xl border border-white/80 dark:border-white/20" onclick="event.stopPropagation()">
      <h3 class="text-sm font-black text-neutral-900 dark:text-white flex items-center gap-2">
        <i data-lucide="folder-edit" class="w-4 h-4 text-blue-500"></i> Edit Subject Folder
      </h3>
      <input type="hidden" id="edit-subject-id">
      <div class="space-y-3 text-xs">
        <div>
          <label class="font-bold text-neutral-600 dark:text-neutral-300">Subject Name</label>
          <input id="edit-subject-name-field" type="text" class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-neutral-800 dark:text-white outline-none">
        </div>
        <div>
          <label class="font-bold text-neutral-600 dark:text-neutral-300">Folder Accent Color</label>
          <div class="flex items-center gap-2 mt-1">
            <input type="color" id="edit-subject-color-field" value="#0D82FF" class="w-9 h-9 p-1 rounded-xl bg-transparent cursor-pointer border border-[#B8DAFF]/60 dark:border-white/15">
            <span class="text-[11px] text-neutral-400">Custom folder & badge tint</span>
          </div>
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t border-[#B8DAFF]/30 dark:border-white/10">
        <button onclick="closeModal('modal-edit-subject')" class="px-3 py-2 rounded-xl text-xs font-semibold bg-white/70 dark:bg-white/10 text-neutral-700 dark:text-neutral-300">Cancel</button>
        <button onclick="saveSubjectEdit()" class="btn-action-pill px-5 py-2 rounded-xl text-xs font-black bg-[#0D82FF] text-white">Save Changes</button>
      </div>
    </div>
  </div>

  <!-- NEW / EDIT DECK MODAL -->
  <div id="modal-deck" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md hidden">
    <div class="modal-panel onyx-panel w-full max-w-sm rounded-3xl p-6 space-y-4 shadow-2xl border border-white/80 dark:border-white/20" onclick="event.stopPropagation()">
      <h3 class="text-sm font-black text-neutral-900 dark:text-white" id="modal-deck-title">Create New Deck</h3>
      <input type="hidden" id="deck-edit-mode-id">
      <div class="space-y-3 text-xs">
        <div>
          <label class="font-bold text-neutral-600 dark:text-neutral-300">Deck Title</label>
          <input id="deck-title-field" type="text" placeholder="e.g. OSI Model & TCP/IP Stack" class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-neutral-800 dark:text-white outline-none">
        </div>
        <div>
          <label class="font-bold text-neutral-600 dark:text-neutral-300">Subject Folder</label>
          <select id="deck-subject-field" class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-neutral-800 dark:text-white outline-none"></select>
        </div>
        <div>
          <label class="font-bold text-neutral-600 dark:text-neutral-300">Grading Period</label>
          <select id="deck-period-field" class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-neutral-800 dark:text-white outline-none">
            <option value="Prelim">Prelim</option>
            <option value="Midterm">Midterm</option>
            <option value="Semi-Final">Semi-Final</option>
            <option value="Finals">Finals</option>
          </select>
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t border-[#B8DAFF]/30 dark:border-white/10">
        <button onclick="closeModal('modal-deck')" class="px-3 py-2 rounded-xl text-xs font-semibold bg-white/70 dark:bg-white/10 text-neutral-700 dark:text-neutral-300">Cancel</button>
        <button onclick="saveDeckForm()" class="btn-action-pill px-5 py-2 rounded-xl text-xs font-black bg-[#0D82FF] text-white">Save Deck</button>
      </div>
    </div>
  </div>

  <!-- SMART NOTE IMPORTER MODAL -->
  <div id="modal-importer" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-3 md:p-4 bg-black/40 backdrop-blur-md hidden">
    <div class="modal-panel onyx-panel w-full max-w-4xl rounded-3xl p-5 md:p-6 flex flex-col max-h-[92vh] shadow-2xl border border-white/80 dark:border-white/20" onclick="event.stopPropagation()">
      <div class="flex items-center justify-between pb-3 border-b border-[#B8DAFF]/40 dark:border-white/10">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-[#0D82FF] flex items-center justify-center font-bold">
            <i data-lucide="sparkles" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="text-base font-black text-neutral-900 dark:text-white">Smart Note Importer</h3>
            <p class="text-[11px] text-neutral-500 dark:text-neutral-400">Live convert notes into Terms, True/False, or Lists (Editable)</p>
          </div>
        </div>
        <button onclick="closeModal('modal-importer')" class="p-2 rounded-xl hover:bg-white/60 dark:hover:bg-white/10 text-neutral-600 dark:text-neutral-300"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <div class="flex gap-2 pt-3">
        <button onclick="switchImportTab('paste')" id="tab-btn-paste" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-[#0D82FF] text-white shadow-sm">Paste & Convert</button>
        <button onclick="switchImportTab('manual')" id="tab-btn-manual" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white/60 dark:bg-white/10 text-neutral-700 dark:text-neutral-300">Single Card</button>
      </div>

      <div class="py-2.5">
        <label class="text-xs font-bold text-neutral-700 dark:text-neutral-300">Target Deck</label>
        <select id="import-target-deck" class="w-full mt-1 p-2 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-xs font-semibold outline-none focus:border-[#0D82FF] text-neutral-800 dark:text-white"></select>
      </div>

      <div id="import-paste-view" class="grid grid-cols-1 md:grid-cols-2 gap-3 flex-1 overflow-hidden">
        <div class="flex flex-col h-full">
          <div class="flex justify-between items-center mb-1">
            <span class="text-[11px] font-bold text-neutral-500 uppercase tracking-wider">Module Text</span>
            <span class="text-[10px] text-neutral-400 truncate">Term - Def, Term: Def, or List: a, b</span>
          </div>
          <textarea id="import-textarea" oninput="liveParseNotes()" placeholder="RAM - Temporary volatile memory
ROM: Permanent non-volatile storage
HTTP transmits unencrypted plaintext = True

Network Topologies:
a. Mesh
b. Star
c. Bus" class="w-full flex-1 p-3 rounded-2xl text-xs leading-relaxed bg-white/60 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 outline-none resize-none font-mono text-neutral-800 dark:text-neutral-200 min-h-[140px]"></textarea>
        </div>

        <div class="flex flex-col h-full overflow-hidden">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold text-neutral-500 uppercase tracking-wider">Detection Preview</span>
            <div id="detection-chips" class="flex gap-1.5">
              <span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold">0 Cards</span>
            </div>
          </div>
          <div id="import-preview-box" class="flex-1 overflow-y-auto p-2.5 rounded-2xl bg-white/40 dark:bg-neutral-800/50 border border-[#B8DAFF]/40 dark:border-white/10 space-y-2 text-xs max-h-[220px] md:max-h-none">
            <div class="text-neutral-400 italic">Paste text on the left to see live detection chips and editable cards...</div>
          </div>
        </div>
      </div>

      <div id="import-manual-view" class="hidden flex-col gap-3 flex-1 py-2 overflow-y-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div>
            <label class="text-xs font-bold text-neutral-700 dark:text-neutral-300">Question / Prompt</label>
            <textarea id="manual-prompt" rows="3" placeholder="Enter term definition or question..." class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-xs outline-none text-neutral-800 dark:text-white"></textarea>
          </div>
          <div class="space-y-2.5">
            <div>
              <label class="text-xs font-bold text-neutral-700 dark:text-neutral-300">Format</label>
              <select id="manual-type" class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-xs font-semibold outline-none text-neutral-800 dark:text-white">
                <option value="identification">Identification (Term)</option>
                <option value="enumeration">Enumeration / List</option>
                <option value="tf">True / False</option>
              </select>
            </div>
            <div>
              <label class="text-xs font-bold text-neutral-700 dark:text-neutral-300">Correct Answer</label>
              <input id="manual-answer" type="text" placeholder="Expected answer (or comma-separated for lists)" class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-xs outline-none text-neutral-800 dark:text-white">
            </div>
          </div>
        </div>
        <div class="flex justify-end gap-2 pt-1">
          <button onclick="saveManualCard(true)" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white/80 dark:bg-neutral-700 hover:bg-white border border-[#B8DAFF]/60 dark:border-white/10 text-neutral-800 dark:text-white">Save & Add Another</button>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-3 mt-2 border-t border-[#B8DAFF]/40 dark:border-white/10">
        <button onclick="closeModal('modal-importer')" class="px-4 py-2 rounded-xl text-xs font-semibold bg-white/70 dark:bg-white/10 text-neutral-700 dark:text-neutral-300">Cancel</button>
        <button onclick="commitImportedCards()" id="commit-import-btn" class="btn-action-pill px-5 py-2 rounded-xl text-xs font-black bg-[#0D82FF] text-white shadow-md shadow-blue-500/30">Save All To Deck</button>
      </div>
    </div>
  </div>

  <!-- EXAM CONFIGURATION MODAL -->
  <div id="modal-exam-config" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md hidden">
    <div class="modal-panel onyx-panel w-full max-w-md rounded-3xl p-6 space-y-4 shadow-2xl border border-white/80 dark:border-white/20" onclick="event.stopPropagation()">
      <div class="flex items-center justify-between border-b border-[#B8DAFF]/40 dark:border-white/10 pb-2">
        <h3 class="text-sm font-black text-neutral-900 dark:text-white flex items-center gap-2">
          <i data-lucide="clipboard-check" class="w-4 h-4 text-emerald-500"></i> Practice Exam Config
        </h3>
        <button onclick="closeModal('modal-exam-config')" class="p-1 rounded-lg hover:bg-white/60 dark:hover:bg-white/10 text-neutral-600 dark:text-neutral-300"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <div class="space-y-3 text-xs">
        <div>
          <label class="font-bold text-neutral-700 dark:text-neutral-300">Number of Questions</label>
          <div class="grid grid-cols-4 gap-2 mt-1" id="exam-pool-size">
            <button type="button" class="py-2 rounded-xl font-bold transition bg-[#0D82FF] text-white" data-val="10">10</button>
            <button type="button" class="py-2 rounded-xl font-bold transition bg-white/70 dark:bg-white/10 text-neutral-700 dark:text-white" data-val="20">20</button>
            <button type="button" class="py-2 rounded-xl font-bold transition bg-white/70 dark:bg-white/10 text-neutral-700 dark:text-white" data-val="50">50</button>
            <button type="button" class="py-2 rounded-xl font-bold transition bg-white/70 dark:bg-white/10 text-neutral-700 dark:text-white" data-val="All">All</button>
          </div>
        </div>

        <div>
          <label class="font-bold text-neutral-700 dark:text-neutral-300">Testing Direction</label>
          <select id="exam-direction-select" class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 outline-none text-neutral-800 dark:text-white font-medium">
            <option value="def-term">Definition &rarr; Term</option>
            <option value="term-def">Term &rarr; Definition</option>
            <option value="mixed">Mixed Direction</option>
          </select>
        </div>

        <div>
          <label class="font-bold text-neutral-700 dark:text-neutral-300 mb-1 block">Enabled Formats</label>
          <div class="grid grid-cols-2 gap-2" id="format-pills-container">
            <label class="format-toggle-pill block cursor-pointer">
              <input type="checkbox" id="fmt-ident" checked class="hidden peer">
              <div class="p-2.5 rounded-xl border border-[#B8DAFF]/50 dark:border-white/10 bg-white/60 dark:bg-neutral-800 font-bold text-neutral-700 dark:text-neutral-300 flex items-center justify-between text-xs transition peer-checked:bg-[#0D82FF] peer-checked:border-[#0D82FF] peer-checked:text-white">
                <span>Identification</span>
                <i data-lucide="check" class="w-3.5 h-3.5 opacity-0 peer-checked:opacity-100 transition"></i>
              </div>
            </label>

            <label class="format-toggle-pill block cursor-pointer">
              <input type="checkbox" id="fmt-mcq" checked class="hidden peer">
              <div class="p-2.5 rounded-xl border border-[#B8DAFF]/50 dark:border-white/10 bg-white/60 dark:bg-neutral-800 font-bold text-neutral-700 dark:text-neutral-300 flex items-center justify-between text-xs transition peer-checked:bg-[#0D82FF] peer-checked:border-[#0D82FF] peer-checked:text-white">
                <span>Multiple Choice</span>
                <i data-lucide="check" class="w-3.5 h-3.5 opacity-0 peer-checked:opacity-100 transition"></i>
              </div>
            </label>

            <label class="format-toggle-pill block cursor-pointer">
              <input type="checkbox" id="fmt-enum" checked class="hidden peer">
              <div class="p-2.5 rounded-xl border border-[#B8DAFF]/50 dark:border-white/10 bg-white/60 dark:bg-neutral-800 font-bold text-neutral-700 dark:text-neutral-300 flex items-center justify-between text-xs transition peer-checked:bg-[#0D82FF] peer-checked:border-[#0D82FF] peer-checked:text-white">
                <span>Lists / Enum</span>
                <i data-lucide="check" class="w-3.5 h-3.5 opacity-0 peer-checked:opacity-100 transition"></i>
              </div>
            </label>

            <label class="format-toggle-pill block cursor-pointer">
              <input type="checkbox" id="fmt-tf" checked class="hidden peer">
              <div class="p-2.5 rounded-xl border border-[#B8DAFF]/50 dark:border-white/10 bg-white/60 dark:bg-neutral-800 font-bold text-neutral-700 dark:text-neutral-300 flex items-center justify-between text-xs transition peer-checked:bg-[#0D82FF] peer-checked:border-[#0D82FF] peer-checked:text-white">
                <span>True / False</span>
                <i data-lucide="check" class="w-3.5 h-3.5 opacity-0 peer-checked:opacity-100 transition"></i>
              </div>
            </label>
          </div>
        </div>

        <div class="flex items-center justify-between p-3 rounded-2xl bg-white/60 dark:bg-neutral-800 border border-[#B8DAFF]/40 dark:border-white/10">
          <div>
            <h4 class="font-bold text-neutral-800 dark:text-white">Countdown Speed Timer</h4>
            <p class="text-[10px] text-neutral-400">20 seconds per question with countdown alert</p>
          </div>
          <input type="checkbox" id="exam-timer-toggle" checked class="w-4 h-4 accent-[#0D82FF]">
        </div>
      </div>

      <button onclick="startPracticeExam()" class="w-full btn-action-pill py-3 rounded-2xl text-xs font-black bg-[#0D82FF] text-white shadow-lg shadow-blue-500/30">
        Begin Exam
      </button>
    </div>
  </div>

  <!-- STUDY SHEET EXPORT MODAL -->
  <div id="modal-export-pdf" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md hidden">
    <div class="modal-panel onyx-panel w-full max-w-sm rounded-3xl p-6 space-y-4 shadow-2xl border border-white/80 dark:border-white/20" onclick="event.stopPropagation()">
      <div class="flex items-center justify-between border-b border-[#B8DAFF]/40 dark:border-white/10 pb-2">
        <h3 class="text-sm font-black text-neutral-900 dark:text-white flex items-center gap-2">
          <i data-lucide="file-down" class="w-4 h-4 text-blue-500"></i> Export Study Sheet
        </h3>
        <button onclick="closeModal('modal-export-pdf')" class="p-1 rounded-lg hover:bg-white/60 dark:hover:bg-white/10 text-neutral-600 dark:text-neutral-300"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <div class="space-y-3 text-xs">
        <div class="p-3 rounded-2xl bg-white/60 dark:bg-neutral-800 border border-[#B8DAFF]/40 dark:border-white/10 flex items-center justify-between">
          <div>
            <h4 class="font-bold text-neutral-800 dark:text-white">Blank Exam Mode</h4>
            <p class="text-[10px] text-neutral-500">Omits answers for blank handwritten practice</p>
          </div>
          <input type="checkbox" id="pdf-blank-exam-toggle" class="w-4 h-4 accent-[#0D82FF]">
        </div>
        <p class="text-[11px] text-neutral-500">Exports a clean, print-optimized document formatting all deck prompts into standard study layouts.</p>
      </div>

      <button onclick="generateStudySheetPDF()" class="w-full btn-action-pill py-3 rounded-2xl text-xs font-black bg-[#0D82FF] text-white shadow-lg shadow-blue-500/30">
        Download Clean PDF
      </button>
    </div>
  </div>

  <!-- CARD EDITOR MODAL -->
  <div id="modal-card-editor" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md hidden">
    <div class="modal-panel onyx-panel w-full max-w-lg rounded-3xl p-6 space-y-4 shadow-2xl border border-white/80 dark:border-white/20" onclick="event.stopPropagation()">
      <div class="flex items-center justify-between border-b border-[#B8DAFF]/40 dark:border-white/10 pb-2">
        <h3 class="text-sm font-black text-neutral-900 dark:text-white flex items-center gap-2">
          <i data-lucide="edit-3" class="w-4 h-4 text-blue-500"></i> Edit Flashcard
        </h3>
        <button onclick="closeModal('modal-card-editor')" class="p-1 rounded-lg hover:bg-white/60 dark:hover:bg-white/10 text-neutral-600 dark:text-neutral-300"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <input type="hidden" id="edit-card-id">

      <div class="space-y-3 text-xs">
        <div>
          <label class="font-bold text-neutral-700 dark:text-neutral-300">Prompt / Question</label>
          <textarea id="edit-card-prompt" rows="3" class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-xs text-neutral-800 dark:text-white outline-none"></textarea>
        </div>

        <div>
          <label class="font-bold text-neutral-700 dark:text-neutral-300">Answer / Term</label>
          <input id="edit-card-answer" type="text" class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-xs text-neutral-800 dark:text-white outline-none">
        </div>

        <div>
          <label class="font-bold text-neutral-700 dark:text-neutral-300">Format</label>
          <select id="edit-card-type" class="w-full mt-1 p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-xs text-neutral-800 dark:text-white outline-none font-semibold">
            <option value="identification">Identification</option>
            <option value="enumeration">Enumeration / List</option>
            <option value="tf">True / False</option>
          </select>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t border-[#B8DAFF]/30 dark:border-white/10">
        <button onclick="closeModal('modal-card-editor')" class="px-3 py-2 rounded-xl text-xs font-semibold bg-white/70 dark:bg-white/10 text-neutral-700 dark:text-neutral-300">Cancel</button>
        <button onclick="saveCardEdit()" class="btn-action-pill px-5 py-2 rounded-xl text-xs font-black bg-[#0D82FF] text-white">Save Changes</button>
      </div>
    </div>
  </div>

  <!-- CUSTOM STYLED DIALOG MODAL -->
  <div id="modal-app-dialog" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md hidden">
    <div class="modal-panel onyx-panel w-full max-w-sm rounded-3xl p-6 space-y-4 shadow-2xl border border-white/80 dark:border-white/20" onclick="event.stopPropagation()">
      <div class="flex items-center gap-2">
        <div id="dialog-icon-wrap" class="w-8 h-8 rounded-xl bg-blue-500/10 text-[#0D82FF] flex items-center justify-center font-bold">
          <i data-lucide="info" class="w-4 h-4" id="dialog-icon"></i>
        </div>
        <h3 id="dialog-title" class="text-sm font-black text-neutral-900 dark:text-white">Notification</h3>
      </div>
      <p id="dialog-message" class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed"></p>
      <div id="dialog-input-wrapper" class="hidden">
        <input type="text" id="dialog-prompt-input" class="w-full p-2.5 rounded-xl bg-white/80 dark:bg-neutral-800 border border-[#B8DAFF]/60 dark:border-white/15 text-xs text-neutral-800 dark:text-white outline-none">
      </div>
      <div class="flex justify-end gap-2 pt-2 border-t border-[#B8DAFF]/30 dark:border-white/10" id="dialog-action-buttons"></div>
    </div>
  </div>

<!-- QUICK ACTION DECK PICKER MODAL -->
  <div id="modal-deck-picker" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md hidden">
    <div class="modal-panel onyx-panel w-full max-w-sm rounded-3xl p-6 space-y-4 shadow-2xl border border-white/80 dark:border-white/20" onclick="event.stopPropagation()">
      <div class="flex items-center justify-between border-b border-[#B8DAFF]/40 dark:border-white/10 pb-2">
        <h3 class="text-sm font-black text-neutral-900 dark:text-white flex items-center gap-2" id="deck-picker-title">
          <i data-lucide="layers" class="w-4 h-4 text-blue-500"></i> Select Deck
        </h3>
        <button onclick="closeModal('modal-deck-picker')" class="p-1 rounded-lg hover:bg-white/60 dark:hover:bg-white/10 text-neutral-600 dark:text-neutral-300">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <p class="text-xs text-neutral-500 dark:text-neutral-400" id="deck-picker-description">
        Choose which deck you want to study:
      </p>

      <div class="space-y-2 max-h-[50vh] overflow-y-auto pr-1" id="deck-picker-list">
        <!-- Decks populated dynamically -->
      </div>

      <div class="flex justify-end pt-2 border-t border-[#B8DAFF]/30 dark:border-white/10">
        <button onclick="closeModal('modal-deck-picker')" class="px-4 py-2 rounded-xl text-xs font-semibold bg-white/70 dark:bg-white/10 text-neutral-700 dark:text-neutral-300">
          Cancel
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST SHELF -->
  <div id="toast-shelf" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>
    
  <script src="~/js/MainPage/mainpage.js"></script>
</body>
</html>
